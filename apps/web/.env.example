# Copia questo file in .env.local. URL e chiave publishable sono fatti per stare nel browser
# (Supabase > Project Settings > API Keys); la chiave secret non va mai qui.
VITE_SUPABASE_URL=https://<ref-del-progetto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Facoltativa: chiave pubblica VAPID delle notifiche push (pnpm push:keys). Senza, l'app non le propone.
VITE_VAPID_PUBLIC_KEY=
